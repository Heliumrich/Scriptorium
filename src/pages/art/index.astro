---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";
import Thumb from "../../components/Thumb.astro";
import {
  fetchFromDirectus,
  getAssetURL,
  getArtworkTitle,
  fileIdOf,
} from "../../lib/directus";

type Artwork = {
  id: string | number;
  slug: string;
  title_french?: string | null;
  title_original?: string | null;
  title_english?: string | null;
  year?: string | number | null;
  image?: unknown;
  date_created?: string | null;
};

type Artist = {
  id: string | number;
  slug: string;
  name: string;
};

const artists =
  (await fetchFromDirectus<Artist[]>(
    "artists?filter[status][_eq]=published&fields=id,slug,name&sort=name&limit=100",
  )) || [];

const artworks =
  (await fetchFromDirectus<Artwork[]>(
    "artworks?filter[status][_eq]=published&fields=id,slug,title_french,title_original,title_english,year,image,date_created&sort=-date_created&limit=24",
  )) || [];

const latest = artworks.slice(0, 6);
const hasError = artists.length === 0 && artworks.length === 0;
---

<BaseLayout title="Art" description="La noble tradition de l'Art Chrétien">
  <main class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Cabinet d’images</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">Art</h1>
    <OrnamentRule class="my-5 max-w-sm" />
    <p class="max-w-2xl text-muted">
      Offrir au regard ce qui élève l'esprit : la noble tradition de l'Art Chrétien.
    </p>

    {
      hasError && (
        <div class="panel mt-8 rounded-xl p-6 text-muted">
          <p class="font-display text-xl text-fg">Le catalogue n’a pas pu être chargé.</p>
          <p class="mt-2 text-sm">Le catalogue Directus est injoignable pour le moment.</p>
        </div>
      )
    }

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href="/personalites"
        class="panel rounded-xl p-8 transition-transform hover:-translate-y-0.5"
      >
        <h2 class="font-display text-3xl">Personnalités illustres</h2>
        <p class="mt-2 text-sm text-muted">
          {
            artists.length
              ? `${artists.length} notices — Artistes, Saints, Monarques et Écrivains`
              : "Voir les personnalités illustres."
          }
        </p>
      </a>
      <a
        href="/oeuvres"
        class="panel rounded-xl p-8 transition-transform hover:-translate-y-0.5"
      >
        <h2 class="font-display text-3xl">Œuvres</h2>
        <p class="mt-2 text-sm text-muted">
          {
            artworks.length
              ? `${artworks.length}+ œuvres — tableaux, fresques, sculptures.`
              : "Parcourir le catalogue des œuvres."
          }
        </p>
      </a>
    </div>

    {
      latest.length > 0 && (
        <section class="mt-14">
          <h2 class="font-display text-3xl">Derniers ajouts</h2>
          <OrnamentRule class="my-5 max-w-xs" />
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {latest.map((work, i) => {
              const id = fileIdOf(work.image);
              const src = getAssetURL(id, "thumbnail");
              return (
                <a href={`/oeuvres/${work.slug}`} class="group">
                  <Thumb src={src} alt={getArtworkTitle(work)} loading={i < 3 ? "eager" : "lazy"} fetchpriority={i < 3 ? "high" : "low"} />
                  <h3 class="mt-3 font-display text-lg group-hover:underline">
                    {getArtworkTitle(work)}
                  </h3>
                  {work.year && <p class="text-sm text-muted">{work.year}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
