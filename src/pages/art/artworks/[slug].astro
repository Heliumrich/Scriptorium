---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fetchFromDirectus, getAssetURL } from '../../../lib/directus';

export async function getStaticPaths() {
  const artworks = await fetchFromDirectus('artworks?filter[status][_eq]=published') || [];
  
  return artworks.map((work: any) => ({
    params: { slug: work.slug },
    props: { work }
  }));
}

const { work } = Astro.props;

// On récupère les relations plus complètement
const fullWork = await fetchFromDirectus(
  `artworks/${work.id}?fields=*,artist.id,artist.name,artist.slug,depicted.artists_id.id,depicted.artists_id.name,depicted.artists_id.slug,image.*,original_file.*`
);

const data = fullWork || work;

function getTitle(w: any) {
  return w.title_french || w.title_original || w.title_english || 'Sans titre';
}

const title = getTitle(data);
const imageId = data.image?.id || data.image;
const originalId = data.original_file?.id || data.original_file || imageId;

// URLs des différentes tailles
const imgThumbnail = getAssetURL(imageId, 'thumbnail');
const imgMedium = getAssetURL(imageId, 'medium');
const imgLarge = getAssetURL(imageId, 'large');
const imgXLarge = getAssetURL(imageId, 'xlarge');
const downloadUrl = getAssetURL(originalId); // version originale
---

<BaseLayout title={title} description={data.description}>
  <main class="min-h-screen">
    <!-- Bouton retour -->
    <div class="px-6 pt-6">
      <a href="/art/artworks" class="text-sm text-neutral-500 hover:text-neutral-800">← Œuvres</a>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-10">
      
      <!-- ========== IMAGE ========== -->
      <div class="relative">
        <button
          id="open-lightbox"
          class="block w-full cursor-zoom-in group"
          aria-label="Voir en grand"
        >
          <img
            src={imgLarge}
            srcset={`
              ${imgMedium} 1200w,
              ${imgLarge} 2000w,
              ${imgXLarge} 3200w
            `}
            sizes="(max-width: 1024px) 100vw, 70vw"
            alt={title}
            class="w-full h-auto max-h-[85vh] object-contain rounded-lg bg-neutral-100"
            loading="eager"
          />
        </button>

        <!-- Bouton télécharger -->
        <a
          href={downloadUrl}
          download
          class="absolute bottom-4 right-4 flex items-center gap-2 px-4 py-2 bg-black/70 hover:bg-black text-white text-sm rounded-lg backdrop-blur transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Télécharger
        </a>
      </div>

      <!-- ========== BANDEAU D'INFOS ========== -->
      <aside class="lg:sticky lg:top-8 lg:self-start space-y-6">
        <div>
          <h1 class="text-2xl font-bold leading-tight mb-1">{title}</h1>
          {data.title_original && data.title_french && data.title_original !== data.title_french && (
            <p class="text-neutral-500 text-sm italic">{data.title_original}</p>
          )}
        </div>

        <!-- Artiste -->
        {data.artist && (
          <div>
            <h3 class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-1">Artiste</h3>
            <a href={`/art/artists/${data.artist.slug}`} class="text-lg hover:underline">
              {data.artist.name}
            </a>
          </div>
        )}

        <!-- Personnes représentées -->
        {data.depicted && data.depicted.length > 0 && (
          <div>
            <h3 class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-1">Représente</h3>
            <div class="flex flex-wrap gap-2">
              {data.depicted.map((d: any) => {
                const person = d.artists_id || d;
                return (
                  <a
                    href={`/art/artists/${person.slug}`}
                    class="badge px-2.5 py-1 bg-neutral-100 hover:bg-neutral-200 rounded-full text-sm transition"
                  >
                    {person.name}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Métadonnées -->
        <div class="space-y-3 text-sm">
          {data.year && (
            <div class="flex justify-between gap-4">
              <span class="text-neutral-400">Année</span>
              <span>{data.year}</span>
            </div>
          )}
          {data.technique && (
            <div class="flex justify-between gap-4">
              <span class="text-neutral-400">Technique</span>
              <span class="text-right">{data.technique}</span>
            </div>
          )}
          {data.dimensions && (
            <div class="flex justify-between gap-4">
              <span class="text-neutral-400">Dimensions</span>
              <span>{data.dimensions}</span>
            </div>
          )}
          {data.location && (
            <div class="flex justify-between gap-4">
              <span class="text-neutral-400">Localisation</span>
              <span class="text-right">{data.location}</span>
            </div>
          )}
        </div>

        <!-- Description -->
        {data.description && (
          <div class="pt-4 border-t border-neutral-200">
            <h3 class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-2">Description</h3>
            <div class="prose prose-sm prose-neutral max-w-none text-neutral-700">
              <Fragment set:html={data.description} />
            </div>
          </div>
        )}

        <!-- Tags -->
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {data.tags.map((tag: string) => (
              <span class="badge px-2 py-0.5 bg-neutral-100 text-neutral-600 text-xs rounded">
                {tag}
              </span>
            ))}
          </div>
        )}
      </aside>
    </div>
  </main>

  <!-- ========== LIGHTBOX ========== -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/90 items-center justify-center p-4">
    <button
      id="close-lightbox"
      class="absolute top-4 right-4 text-white/80 hover:text-white text-3xl leading-none"
      aria-label="Fermer"
    >
      ×
    </button>
    <img
      id="lightbox-img"
      src={imgXLarge || imgLarge}
      alt={title}
      class="max-w-full max-h-full object-contain"
    />
  </div>

	<script define:vars={{ downloadUrl, imgLarge, imgXLarge }}>
	  const openBtn = document.getElementById('open-lightbox');
	  const lightbox = document.getElementById('lightbox');
	  const closeBtn = document.getElementById('close-lightbox');
	  const mainImage = document.querySelector('#open-lightbox img');
	  const lightboxImg = document.getElementById('lightbox-img');

	  const normalSrc = mainImage?.src;
	  const normalSrcset = mainImage?.getAttribute('srcset') || '';
	  const maxSrc = downloadUrl;

	  // ===== Lightbox =====
	  openBtn?.addEventListener('click', () => {
		lightbox?.classList.remove('hidden');
		lightbox?.classList.add('flex');
		document.body.style.overflow = 'hidden';
	  });

	  function closeLightbox() {
		lightbox?.classList.add('hidden');
		lightbox?.classList.remove('flex');
		document.body.style.overflow = '';
	  }

	  closeBtn?.addEventListener('click', closeLightbox);

	  lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	  });

	  document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeLightbox();
	  });

	  // ===== Qualité max =====
	  function applyQuality(max) {
		if (!mainImage) return;

		if (max) {
		  mainImage.src = maxSrc;
		  mainImage.removeAttribute('srcset');
		  if (lightboxImg) lightboxImg.src = maxSrc;
		} else {
		  mainImage.src = normalSrc;
		  mainImage.setAttribute('srcset', normalSrcset);
		  if (lightboxImg) lightboxImg.src = imgXLarge || imgLarge;
		}
	  }

	  // Appliquer au chargement
	  if (localStorage.getItem('quality-max') === 'true') {
		applyQuality(true);
	  }

	  // Écouter les changements du switch global
	  window.addEventListener('quality-change', (e) => {
		applyQuality(e.detail.max);
	  });
	</script>
</BaseLayout>