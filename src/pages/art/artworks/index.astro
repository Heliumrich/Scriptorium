---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Œuvres" description="Liste des œuvres d'art">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <div class="mb-10">
      <a href="/art" class="text-sm text-neutral-500 hover:text-neutral-800">← Galerie</a>
      <h1 class="text-3xl font-bold mt-2">Œuvres</h1>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <p class="text-neutral-500 col-span-full">Aucune œuvre pour le moment.</p>
    </div>
  </main>
</BaseLayout>