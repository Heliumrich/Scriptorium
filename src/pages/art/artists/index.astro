---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fetchFromDirectus, getAssetURL } from '../../../lib/directus';

const artists = await fetchFromDirectus('artists?filter[status][_eq]=published&sort=name') || [];
---

<BaseLayout title="Artistes">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-10">
      <div>
        <a href="/art" class="text-sm text-neutral-500 hover:text-neutral-800">← Galerie</a>
        <h1 class="font-title text-3xl font-bold mt-2">Artistes</h1>
      </div>

      <!-- Switch Grille / Liste -->
      <div class="flex gap-1 bg-neutral-100 p-1 rounded-lg">
        <button id="btn-grid" class="px-3 py-1.5 text-sm rounded-md bg-white shadow-sm font-medium">
          Grille
        </button>
        <button id="btn-list" class="px-3 py-1.5 text-sm rounded-md text-neutral-600">
          Liste
        </button>
      </div>
    </div>

    {artists.length === 0 ? (
      <p class="text-neutral-500">Aucun artiste publié pour le moment.</p>
    ) : (
      <>
        <!-- Vue Grille -->
        <div id="view-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {artists.map((artist: any) => (
            <a href={`/art/artists/${artist.slug}`} class="group block">
              <div class="aspect-square bg-neutral-100 rounded-lg overflow-hidden mb-3">
                {artist.photo ? (
                  <img
                    src={getAssetURL(artist.photo, 'thumbnail')}
                    alt={artist.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-neutral-400 text-sm">
                    Pas d'image
                  </div>
                )}
              </div>
              <h2 class="font-medium group-hover:underline">{artist.name}</h2>
              {artist.short_description && (
                <p class="text-sm text-neutral-500 line-clamp-2 mt-1">{artist.short_description}</p>
              )}
            </a>
          ))}
        </div>

        <!-- Vue Liste (cachée par défaut) -->
        <div id="view-list" class="hidden flex flex-col gap-3">
          {artists.map((artist: any) => (
            <a href={`/art/artists/${artist.slug}`} class="group flex items-center gap-4 p-3 rounded-lg hover:bg-neutral-100 transition">
              <div class="w-16 h-16 rounded-md overflow-hidden bg-neutral-200 shrink-0">
                {artist.photo ? (
                  <img
                    src={getAssetURL(artist.photo, 'thumbnail')}
                    alt={artist.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-neutral-400 text-xs">—</div>
                )}
              </div>
              <div class="min-w-0">
                <h2 class="font-medium group-hover:underline truncate">{artist.name}</h2>
                {artist.short_description && (
                  <p class="text-sm text-neutral-500 truncate">{artist.short_description}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </main>

  <script>
    const btnGrid = document.getElementById('btn-grid');
    const btnList = document.getElementById('btn-list');
    const viewGrid = document.getElementById('view-grid');
    const viewList = document.getElementById('view-list');

    btnGrid?.addEventListener('click', () => {
      viewGrid?.classList.remove('hidden');
      viewList?.classList.add('hidden');
      btnGrid.classList.add('bg-white', 'shadow-sm', 'font-medium');
      btnGrid.classList.remove('text-neutral-600');
      btnList?.classList.remove('bg-white', 'shadow-sm', 'font-medium');
      btnList?.classList.add('text-neutral-600');
    });

    btnList?.addEventListener('click', () => {
      viewList?.classList.remove('hidden');
      viewGrid?.classList.add('hidden');
      btnList.classList.add('bg-white', 'shadow-sm', 'font-medium');
      btnList.classList.remove('text-neutral-600');
      btnGrid?.classList.remove('bg-white', 'shadow-sm', 'font-medium');
      btnGrid?.classList.add('text-neutral-600');
    });
  </script>
</BaseLayout>