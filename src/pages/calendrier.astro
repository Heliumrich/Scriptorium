---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrnamentRule from "../components/OrnamentRule.astro";
import { liturgicalDay, liturgicalColorHex } from "../lib/liturgical";

const today = liturgicalDay();
---

<BaseLayout title="Calendrier" description="Année liturgique — couleur du jour et temps">
  <main class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Année liturgique</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">Calendrier</h1>
    <OrnamentRule class="my-5 max-w-sm" />

    <article class="panel max-w-lg rounded-xl p-6 sm:p-8">
      <p class="text-xs uppercase tracking-[0.22em] text-muted">Aujourd’hui</p>
      <div class="mt-4 flex items-center gap-3">
        <span
          class="size-5 rounded-full border border-border"
          style={`background: ${liturgicalColorHex(today.color)}`}
          title={today.color}></span>
        <h2 class="font-display text-2xl leading-tight">{today.title}</h2>
      </div>
      <p class="mt-3 text-sm text-muted">
        {today.season} · {today.rank}{today.note ? ` · ${today.note}` : ""}
      </p>
      <p class="mt-6 text-sm text-muted">
        En voie d’édification ; contenu réservé
      </p>
    </article>
  </main>
</BaseLayout>
