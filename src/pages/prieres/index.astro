---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";
import CatalogToolbar from "../../components/CatalogToolbar.astro";
import { fetchFromDirectus } from "../../lib/directus";
import { parseTags } from "../../lib/catalog";
import { prayerTitle, firstSentence, type Prayer } from "../../lib/prayer";

export const prerender = true;

const prayers =
  (await fetchFromDirectus<Prayer[]>(
    "prayers?filter[status][_eq]=published&fields=id,slug,sort,title_latin,title_french,description,tags&sort=sort,title_french&limit=-1",
  )) || [];

const allTags = [...new Set(prayers.flatMap((p) => parseTags(p.tags)))].sort((a, b) =>
  a.localeCompare(b, "fr"),
);
const first = prayers.slice(0, 20);
---

<BaseLayout title="Prières" description="Mémento de prières latines et françaises">
  <main class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Mémento</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">Prières</h1>
    <OrnamentRule class="my-5 max-w-sm" />

    <CatalogToolbar showView tags={allTags} searchPlaceholder="Rechercher une prière…" />
    <p id="catalog-status" class="mt-3 text-sm text-muted"></p>

    <p id="catalog-empty" class="panel mt-8 hidden rounded-xl p-6 font-display text-xl">
      Aucune prière ne correspond.
    </p>

    <div id="catalog-grid" class="mt-8 grid gap-4 md:grid-cols-2">
      {
        first.length === 0 ? (
          <div class="panel rounded-xl p-6 text-muted">
            <p class="font-display text-xl text-fg">Aucune prière publiée pour le moment.</p>
          </div>
        ) : (
          first.map((p) => {
            const tags = parseTags(p.tags);
            const excerpt = firstSentence(p.description);
            return (
              <article class="panel rounded-xl p-5 sm:p-6">
                <a href={`/prieres/${p.slug}`} class="block">
                  <h2 class="font-display text-2xl hover:underline">{prayerTitle(p)}</h2>
                  {p.title_latin && p.title_latin !== p.title_french && (
                    <p class="mt-1 italic text-muted">{p.title_latin}</p>
                  )}
                </a>
                {excerpt && <p class="mt-3 line-clamp-3 text-sm text-muted">{excerpt}</p>}
                {tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {tags.map((tag) => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            );
          })
        )
      }
    </div>

    <nav id="catalog-pager" class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Pagination"></nav>
  </main>
</BaseLayout>

<script>
  import { initPrayerList } from "../../lib/prayer-client";
  initPrayerList("/prieres.json");
</script>
