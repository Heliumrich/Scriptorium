---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrnamentRule from "../components/OrnamentRule.astro";
---

<BaseLayout title="À propos" description="Colophon — Literae">
  <main class="page-wrap py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Colophon</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">À propos</h1>
    <OrnamentRule class="my-5 max-w-sm" />
    <div class="max-w-2xl">
      <p class="text-lg leading-relaxed">
        <strong class="font-display">Literae</strong> est un atelier catholique
        francophone. Le Scriptorium y collationne les Litterae Sacrae et accueillera
        une bibliothèque d’ouvrages élus ; s’y joignent la galerie d’art sacré,
        les prières et l’année liturgique.
      </p>
      <p class="mt-4 text-muted">
        <em>Tolle, lege — prends et lis.</em>
      </p>
    </div>
  </main>
</BaseLayout>
