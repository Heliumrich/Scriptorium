---
import BaseLayout from "../layouts/BaseLayout.astro";
import Fleur from "../components/Fleur.astro";
import OrnamentRule from "../components/OrnamentRule.astro";
import { liturgicalDay, liturgicalColorHex } from "../lib/liturgical";

const today = liturgicalDay();

/** Verset du jour — fallback stable si la DB n’est pas montée. */
const verseFallback = {
  bookName: "Jean",
  chapter: 1,
  verse: 1,
  text: "Au commencement était le Verbe, et le Verbe était auprès de Dieu, et le Verbe était Dieu.",
  name_short: "Crampon",
};

const verse = verseFallback;

const FEATURES = [
  {
    href: "/comparateur",
    title: "Comparateur",
    body: "De grandes traductions historiques sûres et de haute qualité",
    icon: "book",
  },
  {
    href: "/art",
    title: "Art",
    body: "Offrir au regard ce qui élève l'esprit : la noble tradition de l'Art Chrétien.",
    icon: "palette",
  },
  {
    href: "/prieres",
    title: "Prières",
    body: "Les fondamentaux, en français et en latin",
    icon: "landmark",
  },
  {
    href: "/calendrier",
    title: "Année liturgique",
    body: "En voie d’édification.",
    icon: "calendar",
  },
];
---

<BaseLayout title="Scriptorium">
  <main>
    <section class="relative overflow-hidden">
      <Fleur
        class="pointer-events-none absolute -right-10 top-4 z-0 hidden size-64 text-gold opacity-10 lg:block"
      />
      <Fleur
        class="pointer-events-none absolute -left-8 bottom-4 z-0 hidden size-48 text-gold opacity-5 lg:block"
      />
      <div class="relative z-10 mx-auto max-w-6xl px-4 pb-16 pt-14 sm:pt-20">
        <p class="mb-5 font-display text-sm uppercase tracking-[0.28em] text-gold">
          Atelier catholique
        </p>
        <h1 class="max-w-3xl font-display text-5xl leading-[0.95] sm:text-7xl">
          Scriptorium
        </h1>
        <p class="mt-4 font-display text-2xl italic text-muted">
          Tolle, lege — prends et lis.
        </p>
        <OrnamentRule class="my-8 max-w-md" />
        <p class="drop-cap text-lg leading-relaxed text-fg">
          Un lieu pour lire La Sainte Écriture dans plusieurs traductions françaises rares,
          contempler l’art chrétien, prier avec les mots de l’Église, et marcher au
          rythme de l’année liturgique.
        </p>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-6 px-4 pb-16 lg:grid-cols-[1.3fr_0.9fr]">
      <article class="panel rounded-xl p-6 sm:p-8">
        <p class="text-xs uppercase tracking-[0.22em] text-muted">Verset du jour</p>
        <h2 class="mt-3 font-display text-2xl">
          {verse.bookName} {verse.chapter}:{verse.verse}
        </h2>
        <p class="mt-4 font-serif text-xl leading-relaxed">{verse.text}</p>
        <p class="mt-4 text-sm text-muted">{verse.name_short}</p>
        <a
          href="/comparateur"
          class="mt-6 inline-flex h-9 items-center rounded-md border border-border px-4 text-sm hover:bg-bg-secondary transition-colors"
        >
          Comparer ce passage
        </a>
      </article>

      <article class="panel rounded-xl p-6 sm:p-8">
        <p class="text-xs uppercase tracking-[0.22em] text-muted">Aujourd’hui</p>
        <div class="mt-4 flex items-center gap-3">
          <span
            class="size-4 rounded-full border border-border"
            style={`background: ${liturgicalColorHex(today.color)}`}
            title={today.color}></span>
          <h2 class="font-display text-2xl leading-tight">{today.title}</h2>
        </div>
        <p class="mt-3 text-sm text-muted">
          {today.season} · {today.rank}{today.note ? ` · ${today.note}` : ""}
        </p>
        <a
          href="/calendrier"
          class="mt-6 inline-flex h-9 items-center px-0 text-sm text-muted hover:text-fg transition-colors"
        >
          Voir le calendrier
        </a>
      </article>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-20">
      <h2 class="font-display text-3xl">Les pupitres</h2>
      <OrnamentRule class="my-5 max-w-xs" />
      <div class="grid gap-4 sm:grid-cols-2">
        {
          FEATURES.map((item) => (
            <a
              href={item.href}
              class="panel group rounded-xl p-6 transition-transform duration-200 hover:-translate-y-0.5"
            >
              <span class="text-gold" aria-hidden="true">
                {item.icon === "book" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                )}
                {item.icon === "palette" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                )}
                {item.icon === "landmark" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/><path d="M18 18v-7"/><path d="M12 2 2 8h20z"/></svg>
                )}
                {item.icon === "calendar" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                )}
              </span>
              <h3 class="mt-4 font-display text-2xl group-hover:underline">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
