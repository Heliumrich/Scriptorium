---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Scriptorium">
  <main class="min-h-screen flex flex-col items-center justify-center gap-12 p-8">
    <h1 class="text-4xl font-bold">Scriptorium</h1>

    <div class="flex flex-col sm:flex-row gap-6">
      <a href="/art" class="px-8 py-4 bg-neutral-800 text-white rounded-lg hover:bg-neutral-700 transition">
        Galerie & Artistes
      </a>

      <a href="/comparateur" class="px-8 py-4 bg-neutral-800 text-white rounded-lg hover:bg-neutral-700 transition">
        Comparateur de traductions
      </a>
    </div>
  </main>
</BaseLayout>