---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";
import CatalogToolbar from "../../components/CatalogToolbar.astro";
import Thumb from "../../components/Thumb.astro";
import {
  fetchFromDirectus,
  getAssetURL,
  getArtworkTitle,
  fileIdOf,
} from "../../lib/directus";
import { PAGE_SIZE, parseTags } from "../../lib/catalog";

export const prerender = true;

const artworks =
  (await fetchFromDirectus<any[]>(
    "artworks?filter[status][_eq]=published&fields=id,slug,title_french,title_original,title_english,year,image,tags,artist.name,artist.slug&sort=-date_created&limit=-1",
  )) || [];

const allTags = [...new Set(artworks.flatMap((w) => parseTags(w.tags)))].sort((a, b) =>
  a.localeCompare(b, "fr"),
);
const firstPage = artworks.slice(0, PAGE_SIZE);
---

<BaseLayout gallery title="Œuvres" description="Catalogue des œuvres d’art sacré">
  <main class="page-wrap py-10">
    <a href="https://art.literae.ch/" class="text-sm text-muted hover:text-fg">← Art</a>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl">Œuvres</h1>
    <OrnamentRule class="my-5 max-w-sm" />

    <CatalogToolbar
      tags={allTags}
      searchPlaceholder="Rechercher un titre (français, original, anglais)…"
    />
    <p id="catalog-status" class="mt-3 text-sm text-muted"></p>

    <p id="catalog-empty" class="panel mt-8 hidden rounded-xl p-6 font-display text-xl">
      Aucune œuvre ne correspond.
    </p>

    <div id="catalog-grid" class="catalog-grid mt-8" data-ssr="1">
      {
        firstPage.map((work, i) => {
          const id = fileIdOf(work.image);
          const src = getAssetURL(id, "thumbnail");
          const title = getArtworkTitle(work);
          const artistName =
            work.artist && typeof work.artist === "object" ? work.artist.name : null;
          return (
            <a href={`/oeuvres/${work.slug}`} class="group">
              <Thumb
                src={src}
                alt={title}
                loading={i < 8 ? "eager" : "lazy"}
                fetchpriority={i < 8 ? "high" : "low"}
                zoom={Boolean(src)}
                data-lightbox
                data-alt={title}
                data-href={`/oeuvres/${work.slug}`}
                data-medium={getAssetURL(id, "medium") || ""}
                data-large={getAssetURL(id, "large") || ""}
                data-xlarge={getAssetURL(id, "xlarge") || ""}
                data-original={getAssetURL(id) || ""}
              />
              <h2 class="mt-3 font-display text-lg group-hover:underline">{title}</h2>
              <p class="text-sm text-muted">{[artistName, work.year].filter(Boolean).join(" · ")}</p>
            </a>
          );
        })
      }
    </div>

    <nav id="catalog-pager" class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Pagination"></nav>
  </main>
</BaseLayout>

<script>
  import { initCatalog } from "../../lib/catalog-client";
  initCatalog({
    jsonUrl: "/oeuvres.json",
    kind: "artwork",
  });
</script>
