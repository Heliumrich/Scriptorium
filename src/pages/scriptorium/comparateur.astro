---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";
import Comparator from "../../components/bible/Comparator.svelte";

export const prerender = true;
---

<BaseLayout
  title="Comparateur"
  description="Collationner les versions françaises de la Sainte Écriture — Crampon, Fillion, Sacy, Segond, Ostervald, Vulgate."
>
  <main class="page-wrap py-10">
    <a href="/scriptorium" class="text-sm text-muted hover:text-fg">← Scriptorium</a>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl">Comparateur</h1>
    <OrnamentRule class="my-5 max-w-sm" />
    <div class="panel rounded-xl p-4 sm:p-6">
      <Comparator client:only="svelte" />
    </div>
  </main>
</BaseLayout>
