---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";

export const prerender = true;
---

<BaseLayout
  title="Scriptorium"
  description="Pupitre de la lettre sainte : comparer les versions de l’Écriture, et consulter, en son temps, une bibliothèque d’ouvrages élus."
>
  <main class="page-wrap py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Litterae sacrae</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">Scriptorium</h1>
    <OrnamentRule class="my-5 max-w-sm" />
    <p class="max-w-3xl text-lg leading-relaxed">
      Ici se tient le pupitre. D’un côté, la Sainte Écriture collationnée en ses
      versions ; de l’autre, une bibliothèque de livres choisis — traductions
      d’ancien régime et textes libres de droits — destinée au conseil et à la lecture.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <a href="/scriptorium/comparateur" class="panel group rounded-xl p-6 no-underline transition-transform duration-200 hover:-translate-y-0.5 sm:p-8">
        <p class="text-xs uppercase tracking-[0.22em] text-muted">Sainte Écriture</p>
        <h2 class="mt-3 font-display text-3xl group-hover:underline">Comparateur</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Collationner les versions de la Sainte Écriture, colonne contre colonne,
          afin que la lettre se révèle par ses témoins.
        </p>
      </a>
      <a href="/scriptorium/bibliotheque" class="panel group rounded-xl p-6 no-underline transition-transform duration-200 hover:-translate-y-0.5 sm:p-8">
        <p class="text-xs uppercase tracking-[0.22em] text-muted">Libri</p>
        <h2 class="mt-3 font-display text-3xl group-hover:underline">Bibliothèque</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Recueillir ouvrages et traductions du Grand Siècle, pour le conseil et
          la lecture assidue.
        </p>
        <p class="mt-4 text-sm text-muted">En voie d’édification ; contenu réservé.</p>
      </a>
    </div>
  </main>
</BaseLayout>
