---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrnamentRule from "../../components/OrnamentRule.astro";
import Comparator from "../../components/bible/Comparator.svelte";

export const prerender = true;
---

<BaseLayout
  title="Comparateur"
  description="Comparer les traductions françaises de la Bible — Crampon, Fillion, Sacy, Segond, Ostervald, Vulgate…"
>
  <main class="page-wrap py-10">
    <p class="text-xs uppercase tracking-[0.22em] text-muted">Sainte Écriture</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">Comparateur</h1>
    <OrnamentRule class="my-5 max-w-sm" />
    <div class="panel rounded-xl p-4 sm:p-6">
      <Comparator client:only="svelte" />
    </div>
  </main>
</BaseLayout>
