---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  gallery?: boolean;
}

const {
  title = "Scriptorium",
  description = "Scriptorium — comparateur de traductions bibliques françaises, galerie d’art sacré, prières et calendrier liturgique.",
  gallery = false,
} = Astro.props;

const fullTitle = title === "Scriptorium" ? title : `${title} — Scriptorium`;
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002654" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {gallery && <link rel="preconnect" href="https://api.literae.ch" crossorigin />}
    <script is:inline>
      try {
        var t = localStorage.getItem("scriptorium-theme");
        if (!t) {
          var m = document.cookie.match(/(?:^|; )scriptorium-theme=([^;]*)/);
          t = m ? decodeURIComponent(m[1]) : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
        if (localStorage.getItem("quality-max") === "true")
          document.documentElement.setAttribute("data-quality", "max");
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased">
    <div class="flex min-h-dvh flex-col">
      <Header />
      <div class="flex-1">
        <slot />
      </div>
      <Footer />
    </div>
    {
      gallery && (
        <script>
          import { hydrateThumbs } from "../lib/thumbs";
          import { initLightbox } from "../lib/lightbox";
          hydrateThumbs();
          initLightbox();
        </script>
      )
    }
  </body>
</html>
