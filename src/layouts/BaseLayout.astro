---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Scriptorium",
  description = "Scriptorium — comparateur de traductions bibliques françaises, galerie d’art sacré, prières et calendrier liturgique.",
} = Astro.props;

const fullTitle = title === "Scriptorium" ? title : `${title} — Scriptorium`;
---

<!doctype html>
<html lang="fr" data-theme="augustin">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002654" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem("scriptorium-theme") || "augustin";
        document.documentElement.setAttribute("data-theme", t);
        if (localStorage.getItem("quality-max") === "true")
          document.documentElement.setAttribute("data-quality", "max");
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased">
    <div class="flex min-h-dvh flex-col">
      <Header />
      <div class="flex-1">
        <slot />
      </div>
      <Footer />
    </div>
    <script is:inline>
      (function () {
        var imgs = document.querySelectorAll("img.thumb-img");
        var vh = window.innerHeight || 0;
        for (var i = 0; i < imgs.length; i++) {
          var img = imgs[i];
          var top = img.getBoundingClientRect().top;
          if (top < vh + 40) {
            img.setAttribute("loading", "eager");
            img.setAttribute("fetchpriority", "high");
            img.loading = "eager";
            img.fetchPriority = "high";
          }
        }
      })();
    </script>
    <script>
      import { hydrateThumbs } from "../lib/thumbs";
      import { initLightbox } from "../lib/lightbox";
      hydrateThumbs();
      initLightbox();
    </script>
  </body>
</html>
