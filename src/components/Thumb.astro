---
import Fleur from "./Fleur.astro";

interface Props {
  src: string | null;
  alt: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  loading = "lazy",
  fetchpriority = "low",
  class: className,
  ...rest
} = Astro.props;
---

<div class="thumb-slot">
  <span class="thumb-ph" aria-hidden="true">
    <Fleur class="size-10 opacity-40" />
  </span>
  {
    src ? (
      <img
        {...rest}
        src={src}
        alt={alt}
        width={400}
        height={400}
        class:list={["thumb-img", className]}
        decoding="async"
        loading={loading}
        fetchpriority={fetchpriority}
      />
    ) : (
      <span class="relative z-10 grid h-full place-items-center text-sm text-muted">Pas d’image</span>
    )
  }
</div>
