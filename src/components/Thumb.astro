---
import { Image } from "astro:assets";
import Fleur from "./Fleur.astro";

interface Props {
  src: string | null;
  alt: string;
  eager?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { src, alt, eager = false, class: className, ...rest } = Astro.props;
---

<div class="thumb-slot">
  <span class="thumb-ph" aria-hidden="true">
    <Fleur class="size-10 opacity-40" />
  </span>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        width={400}
        height={400}
        class:list={["thumb-img", className]}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : "low"}
        {...rest}
      />
    ) : (
      <span class="relative z-10 grid h-full place-items-center text-sm text-muted">Pas d’image</span>
    )
  }
</div>
